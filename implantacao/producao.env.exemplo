# Copie para implantacao/.env no SERVIDOR (o .env nunca vai para o GitHub).
# Gere cada segredo com: openssl rand -base64 32
DOMINIO=gestao.bybusturismo.com.br
AMBIENTE=producao
POSTGRES_PASSWORD=
CHAVE_CRIPTOGRAFIA=
EXIGIR_MFA_ADMIN=true

# Primeiro acesso: administrador com senha temporária (troca obrigatória). Apague estas 2 linhas depois do 1º login.
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=

# Paytour (painel → Avançado → Aplicativos)
PAYTOUR_APP_KEY=
PAYTOUR_APP_SECRET=
PAYTOUR_SINCRONIZAR_MINUTOS=2
PAYTOUR_DIAS_INICIAIS=120

# Robô do Gmail: o mesmo valor vai nas propriedades do script. Gere com: openssl rand -base64 36
INTEGRACAO_EMAIL_TOKEN=

# E-mail de saída (link de "Esqueci minha senha"): Gmail com senha de app. Use implantacao/ligar-email.sh.
EMAIL_USUARIO=
EMAIL_SENHA=

# WhatsApp oficial da Meta (decisão do dono, 09/11/2026; ADR 0010). Para ligar: WHATSAPP_PROVEDOR=meta.
# Token permanente do "usuário do sistema" (permissões whatsapp_business_messaging e whatsapp_business_management),
# ID do número e ID da conta do WhatsApp Business (Gerenciador do WhatsApp). O segredo do app fica em Configurações do app > Básico.
META_WA_TOKEN=
META_WA_NUMERO_ID=
META_WA_CONTA_ID=
META_APP_SECRET=
# Palavra combinada na verificação do endereço de avisos (gere com: openssl rand -hex 24)
META_WA_VERIFY_TOKEN=

# WhatsApp (Evolution API — não oficial, risco de bloqueio do número; ver docs/produto/plano-fase-2.md)
WHATSAPP_PROVEDOR=simulado
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=bybus
# Central de conversas: segredo da rota interna dos avisos da Evolution (gere com: openssl rand -hex 32; mínimo 32 caracteres).
WHATSAPP_WEBHOOK_TOKEN=
# Só para subir a Evolution junto (docker compose --profile whatsapp ...): chave da API e senha do banco dela.
EVOLUTION_DB_PASSWORD=
WHATSAPP_GRUPO_LISTA=
FECHAMENTO_HORA=21:00
URL_PUBLICA=https://gestao.bybusturismo.com.br
# IA (gestores e Turistinha): chave só no cofre/variável de ambiente. Vazio = "IA desligada".
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
IA_LIMITE_MES_USD=60
IA_AVALIACAO_DIARIA=true
IA_AVALIACAO_HORARIO=06:30
