# Copie para implantacao/.env no SERVIDOR (o .env nunca vai para o GitHub).
# Gere cada segredo com: openssl rand -base64 32
DOMINIO=gestao.bybusturismo.com.br
AMBIENTE=producao
POSTGRES_PASSWORD=
CHAVE_CRIPTOGRAFIA=
EXIGIR_MFA_ADMIN=true

# Primeiro acesso: administrador com senha temporária (troca obrigatória). Apague estas 2 linhas depois do 1º login.
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=

# Paytour (painel → Avançado → Aplicativos)
PAYTOUR_APP_KEY=
PAYTOUR_APP_SECRET=
PAYTOUR_SINCRONIZAR_MINUTOS=2
PAYTOUR_DIAS_INICIAIS=120

# Robô do Gmail: o mesmo valor vai nas propriedades do script. Gere com: openssl rand -base64 36
INTEGRACAO_EMAIL_TOKEN=

# WhatsApp (Evolution API — não oficial, risco de bloqueio do número; ver docs/produto/plano-fase-2.md)
WHATSAPP_PROVEDOR=simulado
EVOLUTION_URL=
EVOLUTION_API_KEY=
WHATSAPP_GRUPO_LISTA=
FECHAMENTO_HORA=21:00
URL_PUBLICA=https://gestao.bybusturismo.com.br
