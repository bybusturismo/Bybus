# Copie para apps/api/.env (nunca versione o .env real).
AMBIENTE=desenvolvimento            # desenvolvimento | testes | producao
PORTA=3333
HOST=127.0.0.1
DATABASE_URL=postgres://bybus:SENHA@localhost:5432/bybus_dev
# 32 bytes em base64 — gere com: openssl rand -base64 32
# Em produção, guarde no cofre de segredos do provedor. Perder a chave = perder os documentos cifrados.
CHAVE_CRIPTOGRAFIA=
ORIGEM_WEB=http://localhost:5173
SESSAO_HORAS=12
LIMITE_LOGIN_POR_MINUTO=10
EXIGIR_MFA_ADMIN=true
# Primeiro administrador (senha temporária, troca obrigatória no 1º acesso)
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
# Só em desenvolvimento/testes: cria usuários e reservas fictícias
SEMEAR_FICTICIOS=false
# Robô do Gmail (integracoes/gmail): segredo compartilhado; vazio = entrada automática desligada.
# Gere com: openssl rand -base64 36
INTEGRACAO_EMAIL_TOKEN=
# Paytour (Avançado → Aplicativos no painel). Vazio = sincronização desligada. NUNCA versionar os valores.
PAYTOUR_APP_KEY=
PAYTOUR_APP_SECRET=
PAYTOUR_URL=https://api.paytour.com.br/v2
PAYTOUR_SINCRONIZAR_MINUTOS=5
PAYTOUR_DIAS_INICIAIS=30
# IA (gestores e Turistinha). Sem a chave a IA fica desligada ("IA desligada") e o resto do sistema funciona. NUNCA versionar a chave.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
# Síntese final: vazio = igual a IA_MODELO. Opção mais forte e mais cara: claude-fable-5-1
IA_MODELO_SINTESE=
IA_ESFORCO=medium
IA_ESFORCO_SINTESE=high
IA_ESFORCO_ASSISTENTE=low
# Limite mensal de gasto com IA, em dólares (0 = sem limite)
IA_LIMITE_MES_USD=60
# Avaliação diária dos gestores (America/Sao_Paulo)
IA_AVALIACAO_DIARIA=true
IA_AVALIACAO_HORARIO=06:30
